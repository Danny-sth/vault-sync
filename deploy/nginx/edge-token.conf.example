# Edge-токен периметра. РЕАЛЬНЫЙ файл edge-token.conf — СЕКРЕТ, НЕ в git (.gitignore).
# Грузится в http-контекст раньше default.conf (conf.d/00-edge-token.conf).
# X-Auth-Token == токен → $edge_ok=1, иначе 0 → 401 → fail2ban.
# Токен = VAULT_SYNC_TOKEN (тот же, что шлёт Obsidian-плагин).
#
# На VPS: cp edge-token.conf.example edge-token.conf, вписать токен,
#         docker compose up -d --force-recreate nginx
map_hash_bucket_size 128;
map $http_x_auth_token $edge_ok {
    default 0;
    "<VAULT_SYNC_TOKEN>" 1;
}
