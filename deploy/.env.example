# deploy/.env — ЕДИНСТВЕННЫЙ файл вне git (секреты). chmod 600. Копия — вольт `Coding/Vault Sync/Creds/vault-sync-deploy.env.md`.
# Домен, на который смотрит A-запись нового сервера.
DOMAIN=on-za-menya.online
# Токен синка/REST (плагин Obsidian) = edge-токен nginx (X-Auth-Token).
VAULT_SYNC_TOKEN=
# Токен MCP-эндпоинта /mcp (local-mcp мост, vault-cli).
VAULT_SYNC_MCP_TOKEN=
# Ключ E2EE волта для серверного vault-cli (сервер без него zero-knowledge; нужен только инструментам).
VAULT_PASSPHRASE=
VAULT_SALT_B64=
